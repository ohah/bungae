{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.command // \"\"' | grep -q '^git commit' && bun run lint || true",
            "timeout": 30,
            "statusMessage": "Running lint check..."
          }
        ]
      }
    ]
  }
}
